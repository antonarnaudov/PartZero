{
  "name": "@aicad/agent",
  "version": "0.0.1",
  "description": "The aicad agent orchestrator: a deterministic TypeScript state machine (triage → clarify → spec → build/repair → propose) over the model-agnostic LLM gateway, with an LLM MakerBench solver and a bake-off CLI.",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aicad-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli-runtime": {
      "types": "./dist/cli-runtime.d.ts",
      "import": "./dist/cli-runtime.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:live": "vitest run test/live",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "AICAD_RECORD_FIXTURES=oracle vitest run test/record-fixtures.test.ts",
    "test:live:cli": "vitest run test/live/cli-smoke.live.test.ts"
  },
  "dependencies": {
    "@aicad/agent-tools": "workspace:*",
    "@aicad/cadscript": "workspace:*",
    "@aicad/evals": "workspace:*",
    "@aicad/ir-types": "workspace:*",
    "@aicad/llm-gateway": "workspace:*",
    "@aicad/model-ops": "workspace:*",
    "typescript": "~5.9.3",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@aicad/mcp-server": "workspace:*",
    "@types/node": "^22.15.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
