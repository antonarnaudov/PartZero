{
  "name": "@aicad/cadscript",
  "version": "0.0.1",
  "description": "CadScript: a statically compiled TypeScript subset that compiles to (and prints from) the aicad Feature-Graph IR (v0 at the root, v1 under `v1` / `@aicad/cadscript/v1`).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cadscript": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js"
    },
    "./std": {
      "types": "./std/index.d.ts"
    },
    "./std/index.d.ts": "./std/index.d.ts",
    "./std/v1": {
      "types": "./std/v1/index.d.ts"
    },
    "./std/v1/index.d.ts": "./std/v1/index.d.ts"
  },
  "files": [
    "dist",
    "std"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "vitest run test/generated-files.test.ts test/v1/generated.test.ts --update"
  },
  "dependencies": {
    "@aicad/ir-types": "workspace:*",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "fast-check": "^4.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
