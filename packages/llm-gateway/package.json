{
  "name": "@aicad/llm-gateway",
  "version": "0.0.1",
  "description": "Model-agnostic LLM gateway: unified chat types, per-model profiles, role routing, budget guard, and first-class adapters for Anthropic, OpenAI, Google Gemini and OpenAI-compatible endpoints (official SDKs).",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:live": "vitest run test/live",
    "test:live:cli": "vitest run test/cli-live",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/genai": "^2.24.0",
    "openai": "^7.22.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
