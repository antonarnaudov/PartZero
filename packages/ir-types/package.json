{
  "name": "@aicad/ir-types",
  "version": "0.0.1",
  "description": "TypeScript types and zod schemas for the aicad Feature-Graph IR, generated from the forge-ir JSON Schemas.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate.ts"
  },
  "dependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
