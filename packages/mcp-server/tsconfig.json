{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "..": test/tools.test.ts type-checks createMcpHost() against the gateway's frozen
    // src/cli/mcp.ts (CLI-PROVIDERS.md §7.6). This config never emits (the build uses tsconfig.build.json).
