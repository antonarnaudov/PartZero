{
  "name": "@aicad/mcp-server",
  "version": "0.0.1",
  "description": "The aicad MCP server: a dependency-free stdio shim (`aicad-mcp`) that CLI agents launch through their MCP config, the bridge protocol to a host-side tool broker (scopes, ticket, FIFO, limits, stop gating), tools generated from the agent-tools registry, and an in-process design host for external clients (per-client branches, resources, export directory).",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aicad-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": "./dist/stdio.js",
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "test:live:cli": "tsc -p tsconfig.build.json && vitest run test/live",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aicad/agent-tools": "workspace:*",
    "@aicad/evals": "workspace:*",
    "@aicad/llm-gateway": "workspace:*",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
