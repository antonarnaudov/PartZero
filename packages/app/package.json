{
  "name": "@aicad/app",
  "version": "0.0.1",
  "description": "The aicad application UI (React): viewport host, feature timeline, CadScript code view (Monaco), chat, problems and the typed command layer shared with the agent and MCP. Runs in Electron (@aicad/desktop) and, later, in the browser.",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./bridge": {
      "types": "./dist/lib/bridge.d.ts",
      "import": "./dist/lib/bridge.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build && tsc -p tsconfig.bridge.json",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@aicad/cadscript": "workspace:*",
    "@aicad/forge-web": "workspace:*",
    "@aicad/ir-types": "workspace:*",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
