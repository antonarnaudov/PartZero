{
 "description": "Parameter and field evaluation outcomes (SPEC-v1 \u00a72.1, \u00a72.7, \u00a72.8, \u00a70.5 as ruled by [W0-20] string literals, [W0-23] exponent overflow, [W0-24] -0, [W0-25] bounds and [W0-27] PARAM_FAILED). Each case is a valid `aicad.ir/1` document; `params` maps parameter names to the report entry's `value` (with `bits`, big-endian binary64) or `error` (`code`, and the listed `details` keys, which must be equal; other keys are not compared); `features` maps feature ids to `status` and, for a failed feature, its `error` in the same form. Parameters and features not listed are not checked. Evaluated by Forge (forge-ir tests/v1_conformance_amendments.rs, through forge-regen) and the oracle (W7).",
 "cases": [
  {
   "id": "param-failed-names-the-root-cause",
   "rule": "[W0-27]",
   "document": {
    "schema": "aicad.ir/1",
    "meta": {
     "name": "root"
    },
    "params": [
     {
      "name": "a",
      "unit": "ratio",
      "value": "1 / 0"
     },
     {
      "name": "b",
      "unit": "ratio",
      "value": "a * 2"
     },
     {
      "name": "c",
      "unit": "ratio",
      "value": "b + 1"
     }
    ],
    "parts": [
     {
      "id": "p1",
      "name": "part",
      "features": [
       {
        "type": "sketch",
        "id": "s1",
        "name": "base",
        "plane": "XY",
        "curves": [
         {
          "kind": "rect",
          "id": "outline",
          "center": [
           0,
           0
          ],
          "w": 80,
          "h": 50
         }
        ]
       },
       {
        "type": "extrude",
        "id": "e1",
        "name": "slab",
        "sketch": "s1",
        "distance": "8 + c * 1 mm"
       }
      ]
     }
    ]
   },
   "params": {
    "a": {
     "error": {
      "code": "EXPR_DOMAIN"
     }
    },
    "b": {
     "error": {
      "code": "PARAM_FAILED",
      "details": {
       "param": "a",
       "code": "EXPR_DOMAIN"
      }
     }
    },
    "c": {
     "error": {
      "code": "PARAM_FAILED",
      "details": {
       "param": "a",
       "code": "EXPR_DOMAIN"
      }
     }
    }
   },
   "features": {
    "e1": {
     "status": "error",
     "error": {
      "code": "PARAM_FAILED",
      "details": {
       "param": "a",
       "code": "EXPR_DOMAIN"
      }
     }
    }
   }
  },
