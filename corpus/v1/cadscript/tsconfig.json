{
  // Lets editors and `tsc -p corpus/v1/cadscript` resolve "@aicad/std" (v1) for these CadScript v1 files.
  // The files are generated by `pnpm --filter @aicad/cadscript run generate`; do not edit them by hand.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "paths": {
      "@aicad/std": ["../../../packages/cadscript/std/v1/index.d.ts"]
    }
  },
  "include": ["*.cad.ts"]
}
