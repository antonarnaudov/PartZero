{
  "$schema": "../../../packages/evals/schema/makerbench-task.schema.json",
  "id": "t1-constrained-gusset",
  "tier": "T1",
  "title": "Parametric gusset with a bolt hole",
  "prompt": "Triangular gusset plate, 5 mm thick, lying on Z = 0: a right triangle with the right angle at the origin, a 40 mm leg along +X (parameter base_len) and a 30 mm leg along +Y (parameter rise), with an M4 clearance hole (4.5 mm) whose centre is 8 mm from both legs. Draw it as a fully constrained sketch so the hole stays 8 mm from the legs when the triangle changes.",
  "process": "fdm",
  "tags": ["gusset", "constraints", "parametric", "sketch"],
  "requires": ["ir/1", "sketch/constraints"],
  "reference": "t1-constrained-gusset.cad.ts",
  "hidden_tests": [
    {
      "id": "valid",
      "description": "Evaluates cleanly and every body is a valid closed solid",
      "check": "valid",
      "eq": true
    },
    {
      "id": "size",
      "description": "40 × 30 × 5 mm from the origin",
      "check": "bbox_max",
      "approx": [40, 30, 5],
      "abs": 0.05
    },
    {
      "id": "origin",
      "description": "Right angle at the origin",
      "check": "bbox_min",
      "approx": [0, 0, 0],
      "abs": 0.05
    },
    {
      "id": "hole",
      "description": "An Ø4.5 hole 8 mm from both legs",
      "check": "hole_positions",
      "diameter": [4.45, 4.55],
      "points": [[8, 8, 0]]
    },
    {
      "id": "volume",
      "description": "(600 − π·2.25²)·5 = 2920.5 mm³",
      "check": "volume",
      "approx": 2920.48,
      "rel": 0.002
    },
    {
      "id": "fully_constrained",
      "description": "No under-constrained sketch warning",
      "check": "warning_count",
      "code": "SKETCH_UNDER_CONSTRAINED",
      "eq": 0
    },
    {
      "id": "base_param",
      "description": "base_len = 50: a 50 mm leg, the hole still 8 mm from both legs",
      "check": "param",
      "set": { "base_len": 50 },
      "test": { "check": "hole_positions", "diameter": [4.45, 4.55], "points": [[8, 8, 0]] }
    },
    {
      "id": "base_volume",
      "description": "base_len = 50: (750 − π·2.25²)·5 = 3670.5 mm³",
      "check": "param",
      "set": { "base_len": 50 },
      "test": { "check": "volume", "approx": 3670.48, "rel": 0.002 }
    }
  ]
}
