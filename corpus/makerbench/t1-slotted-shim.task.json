{
  "$schema": "../../packages/evals/schema/makerbench-task.schema.json",
  "id": "t1-slotted-shim",
  "tier": "T1",
  "title": "Slotted motor-mount shim",
  "prompt": "Adjustment shim for a motor mount, laser cut from 1 mm steel: 40 x 20 mm with two slots for M5 screws, each 5.5 mm wide and 12 mm long end to end, running along the long side and centred 10 mm either side of the middle.",
  "process": "laser",
  "tags": ["shim", "sheet", "slots"],
  "requires": ["ir/0"],
  "reference": "t1-slotted-shim.cad.ts",
  "hidden_tests": [
    {
      "id": "valid",
      "description": "Evaluates cleanly and every body is a valid closed solid",
      "check": "valid",
      "eq": true
    },
    {
      "id": "one_body",
      "description": "Exactly one solid body (one printable part)",
      "check": "body_count",
      "eq": 1
    },
    {
      "id": "size",
      "description": "40 x 20 mm, 1 mm thick, ±0.1 mm",
      "check": "bbox_sorted",
      "approx": [1, 20, 40],
      "abs": 0.1
    },
    {
      "id": "two_slots",
      "description": "Two cut-outs (the slots)",
      "check": "inner_loops",
      "eq": 2
    },
    {
      "id": "slot_ends",
      "description": "Each slot has two semicircular 5.5 mm ends (4 arcs of Ø5.5)",
      "check": "curve_count",
      "kind": "arc",
      "diameter": [5.4, 5.7],
      "eq": 4
    },
    {
      "id": "round_faces",
      "description": "Four half-cylinder faces at the slot ends",
      "check": "face_count",
      "type": "cylinder",
      "eq": 4
    },
    {
      "id": "volume",
      "description": "Volume (800 − 2 slots of 6.5·5.5 + π·2.75²)·1 ≈ 681 mm³ ±1%",
      "check": "volume",
      "approx": 680.98,
      "rel": 0.01
    }
  ]
}
