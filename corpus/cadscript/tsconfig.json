{
  // Lets editors and `tsc -p corpus/cadscript` resolve "@aicad/std" for these CadScript files.
  // The files are generated by `pnpm --filter @aicad/cadscript run generate`; do not edit them by hand.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "paths": {
      "@aicad/std": ["../../packages/cadscript/std/index.d.ts"]
    }
  },
  "include": ["*.cad.ts"]
}
