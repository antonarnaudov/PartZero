# Rust
/forge/target/
**/*.rs.bk

# Node / TS
node_modules/
dist/
.turbo/
*.tsbuildinfo
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Corpus / artifacts (large generated data lives outside git)
/corpus/generated/
# Downloaded third-party datasets. Their license record is the tracked
# corpus/EXTERNAL_SOURCES.md (LICENSING.md), which must list a dataset before its first use.
/corpus/external/
/artifacts/
*.stl
!corpus/golden/**/*.stl
*.3mf
*.step
!corpus/golden/**/*.step

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets (API keys for live LLM runs) — never commit
.env
.env.*
!.env.example
